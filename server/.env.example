# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8443
HOST=0.0.0.0
NODE_ENV=production
PUBLIC_ORIGIN=https://relay.example.com

# TLS. Omit both to run plain HTTP behind nginx/Caddy (recommended).
TLS_CERT_PATH=
TLS_KEY_PATH=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# 64+ random hex chars:  openssl rand -hex 48
JWT_SECRET=CHANGE_ME_openssl_rand_hex_48
JWT_TTL_SECONDS=2592000

# Bootstrap secret required to call POST /pair/init. Prevents strangers from
# creating rooms on your server.  openssl rand -hex 32
BOOTSTRAP_SECRET=CHANGE_ME_openssl_rand_hex_32

PAIR_CODE_TTL_SECONDS=300

# ─── STUN / TURN ──────────────────────────────────────────────────────────────
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp

# Must equal coturn's `static-auth-secret` (use-auth-secret mode).
# openssl rand -hex 32
TURN_STATIC_AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32
TURN_CREDENTIAL_TTL_SECONDS=3600

# ─── FCM (wake an offline peer) ───────────────────────────────────────────────
# Absolute path to the Firebase service-account JSON. Leave blank to disable FCM.
FCM_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# ─── Relay behaviour ──────────────────────────────────────────────────────────
OFFLINE_QUEUE_MAX=500
MAX_ENVELOPE_BYTES=131072
SNAPSHOT_PATH=./data/rooms.json
SNAPSHOT_INTERVAL_MS=15000
LOG_LEVEL=info
MAX_RECEIVERS_PER_ROOM=8
