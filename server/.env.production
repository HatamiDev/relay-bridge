# ─── hatamidev.com — production environment ────────────────────────────────
# Copy to `.env` on the host (or point EnvironmentFile at this path directly,
# see deploy/systemd/relay-signaling.service) and fill in every CHANGE_ME.
# No real secrets belong in this file as committed — it is a filled-in
# *example*, not the live config.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8443
# Loopback only: nginx (deploy/nginx/hatamidev.com.conf) terminates TLS on
# 443 and proxies to 127.0.0.1:8443, so the app never listens on a public
# interface directly.
HOST=127.0.0.1
NODE_ENV=production
PUBLIC_ORIGIN=https://hatamidev.com

# TLS terminates at nginx, not here — leave both blank.
TLS_CERT_PATH=
TLS_KEY_PATH=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# openssl rand -hex 48
JWT_SECRET=CHANGE_ME_openssl_rand_hex_48
JWT_TTL_SECONDS=2592000

# openssl rand -hex 32
BOOTSTRAP_SECRET=CHANGE_ME_openssl_rand_hex_32

PAIR_CODE_TTL_SECONDS=300

# ─── STUN / TURN ──────────────────────────────────────────────────────────────
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=turn:turn.hatamidev.com:3478?transport=udp,turn:turn.hatamidev.com:3478?transport=tcp,turns:turn.hatamidev.com:5349?transport=tcp

# Must equal coturn's `static-auth-secret` in deploy/coturn/turnserver.conf.
# openssl rand -hex 32
TURN_STATIC_AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32
TURN_CREDENTIAL_TTL_SECONDS=3600

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local coturn/Redis on the same box, bound to loopback only
# (deploy/redis/redis.conf). Leaving REDIS_URL blank falls back to the
# in-process store — set it to run more than one relay-signaling node.
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=relay:
REDIS_TLS_REJECT_UNAUTHORIZED=true

# ─── FCM (wake an offline peer) ───────────────────────────────────────────────
FCM_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# ─── Relay behaviour ──────────────────────────────────────────────────────────
OFFLINE_QUEUE_MAX=500
MAX_ENVELOPE_BYTES=131072
SNAPSHOT_PATH=./data/rooms.json
SNAPSHOT_INTERVAL_MS=15000
LOG_LEVEL=info
MAX_RECEIVERS_PER_ROOM=8
