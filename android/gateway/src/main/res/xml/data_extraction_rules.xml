<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing is backed up or transferred. The E2EE root key is bound to the
    Android Keystore and could not be restored on another device anyway;
    exporting the surrounding metadata would only leak pairing information.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
