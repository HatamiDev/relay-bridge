<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves this device. The encrypted message cache and the Keystore-
    bound root key are both excluded from cloud backup and device transfer:
    backing up the ciphertext without the hardware key would be useless, and
    backing up anything more would be a leak.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
